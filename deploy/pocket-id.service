[Unit]
Description=Pocket ID Passkey Identity Provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pocket-id
Group=pocket-id
WorkingDirectory=/var/lib/pocket-id
EnvironmentFile=/etc/pocket-id/pocket-id.env
ExecStart=/usr/local/bin/pocket-id
Restart=on-failure
RestartSec=5
StateDirectory=pocket-id
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/pocket-id
# Defense-in-depth sandbox: drop every capability and shrink the syscall surface.
# MemoryDenyWriteExecute is intentionally omitted: the V8 JIT needs W^X pages.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

[Install]
WantedBy=multi-user.target
