# Install this file with restrictive permissions so only root (and the service
# reader) can see the secrets inside:
#   install -m 600 -o root -g root pocket-id.env /etc/pocket-id/pocket-id.env
# Never leave a world-readable copy: ENCRYPTION_KEY protects all stored sessions.
APP_URL=https://auth.example.com
HOST=127.0.0.1
PORT=1411
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_SECRET
DB_CONNECTION_STRING=/var/lib/pocket-id/pocket-id.db
TRUST_PROXY=127.0.0.1
ALLOW_INSECURE_CALLBACK_URLS=false
UI_CONFIG_DISABLED=true
ALLOW_USER_SIGNUPS=disabled
REQUIRE_USER_EMAIL=false
ANALYTICS_DISABLED=true
SESSION_DURATION=60
WEBAUTHN_USER_VERIFICATION=required
LOG_LEVEL=warn
# Provision over loopback, then remove this temporary administrator key.
# STATIC_API_KEY=REPLACE_WITH_SEPARATE_RANDOM_SECRET
